{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CEMRuugVRTxDWWyQrb9die","type":"tool_result","content":"1\t\"\"\"Output gate for briefs: deterministic checks that run on every draft, template or model.\n2\t\n3\tA brief that fails any check is not written, and the failure goes to the error\n4\tlog. The content rules come from iTmethods' own public pages\n5\t(docs/research/itmethods-product-facts.md; operator decision A-029).\n6\t\n7\tHardened after independent QA (Q-005) and security review (D-020):\n8\t- every line is checked, including headings and the Sources section, and the\n9\t  Sources section may only contain source lines in the generated format;\n10\t- a sentence that mentions Reign, Forge or iTmethods (any case) must restate\n11\t  the claim it cites word for word, so the right claim id is needed, not just any;\n12\t- there is no negation escape: only the approved claim text itself may use\n13\t  words like \"certification\" (it says iTmethods does not issue one);\n14\t- links of any shape that are not approved sources are rejected, as are HTML\n15\t  and markdown images, which could leak data when a brief is rendered.\n16\t\n17\tWhat no word list can catch is a claim that is plausible and false. The named\n18\thuman approver is the control for that.\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\timport re\n24\t\n25\tMAX_WORDS = 350  # proposed A-045: a short brief a CAE can read in one sitting\n26\t# The structure the operator decided for the SR 26-2 brief (A-044).\n27\tREQUIRED_SECTIONS = [\"## What changed\", \"## What is certain for this account\", \"## What depends on structure (confirm)\",\n28\t                     \"## What we know about the account\", \"## Where Reign fits\", \"## Suggested next step\",\n29\t                     \"## Suggested recipients in the existing relationship\", \"## Open questions for the account owner\",\n30\t                     \"## Sources\"]\n31\t# Optional owner-only section after the recipients: the agent's risk-lane and engineering-lane framings.\n32\tOPTIONAL_SECTIONS = [\"## Lane framings for the account owner\"]\n33\tKNOWN_HEADINGS = set(REQUIRED_SECTIONS) | set(OPTIONAL_SECTIONS)\n34\tCONDITIONAL_SECTION = \"## What depends on structure (confirm)\"\n35\t# \"Never claim a rule applies\" (A-044): applicability wording only inside the conditional section.\n36\tAPPLIES = re.compile(r\"\\b(applies|apply to (you|the bank|them)|applicable to|in scope|subject to|covered by|falls (under|within)|\"\n37\t                     r\"governs?|governed by|binds?|binding on|must (comply|follow|meet|adopt)|required to (comply|follow)|\"\n38\t                     r\"obliged|obligated|regulated under|compl(y|ies) with)\\b\", re.IGNORECASE)\n39\t# Sections where every line must carry a citation (QA pass 2, C1).\n40\tCITED_SECTIONS = {\"## What changed\", \"## What is certain for this account\", CONDITIONAL_SECTION,\n41\t                  \"## What we know about the account\", \"## Where Reign fits\"}\n42\t# Template sentences about the account that name a product but make no product claim.\n43\tACCOUNT_FACT_SENTENCES = {\"existing forge customer.\"}\n44\t\n45\tCITATION = re.compile(r\"\\[([A-Za-z0-9][A-Za-z0-9:_/.\\-]*)\\]\")\n46\tURL = re.compile(r\"https?://[^\\s,;)\\]]+[^\\s,;.)\\]]\", re.IGNORECASE)\n47\tPRODUCT = re.compile(r\"\\b(reign|forge|itmethods)\\b\", re.IGNORECASE)\n48\tSOURCE_LINE = re.compile(r\"^- \\[([A-Za-z0-9][A-Za-z0-9:_/.\\-]*)\\] (.+)$\")\n49\t\n50\t# Rule 1: never claim or imply compliance, certification, independent assurance or validation.\n51\tCLAIMS = re.compile(\n52\t    r\"\\b(compliant|complian\\w*\\s+(for|with)\\s+you|certif\\w*|accredit\\w*|attest\\w*|audit\\s+opinion|soc\\s*-?\\s*2|\"\n53\t    r\"iso\\s*-?\\s*\\d{4,5}\\s+(certified|compliant)|\"\n54\t    r\"(independent|third[\\s-]*party)\\s*(ly\\s+)?(assurance|validation|validat\\w*|review\\w*|audit\\w*)|\"\n55\t    r\"validated\\s+by|validat\\w*\\s+(your|their|the\\s+bank)|\"\n56\t    r\"(ensure|ensures|guarantee\\w*|achieve\\w*|deliver\\w*|handles?|provides?)\\s+([\\w-]+\\s+){0,3}compliance|\"\n57\t    r\"in\\s+line\\s+with\\s+(sr|osfi|dora|the\\s+guidance|every|all)|\"\n58\t    r\"(satisf\\w*|meets?|fulfil\\w*)\\s+([\\w-]+\\s+){0,3}(expectation|requirement|obligation|guidance|rule)s?|\"\n59\t    r\"sign[\\s-]*off|pass\\w*\\s+([\\w-]+\\s+){0,4}(exam|examination|audit|inspection)s?|soc[\\s-]*(2|ii)\\b|vouch\\w*|\"\n60\t    r\"(examiner|regulator|auditor)s?\\s+([\\w-]+\\s+){0,3}(approv|accept|sign)\\w*)\\b\",\n61\t    re.IGNORECASE)\n62\t# Rule 2: never state a briefing or meeting duration, in digits or words.\n63\tNUMBER_WORDS = (r\"(one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|fifteen|twenty|thirty|forty|\"\n64\t                r\"forty[\\s-]*five|fifty|sixty|ninety|a\\s+couple\\s+of|a\\s+few|several)\")\n65\tDURATION = re.compile(\n66\t    r\"\\b\\d+\\s*(?:-|to|\\u2013)?\\s*\\d*\\s*(?:m|min|mins|minute|minutes|h|hr|hrs|hour|hours)\\b|\"\n67\t    rf\"\\b(half|quarter)[\\s-]+(an|of\\s+an)[\\s-]+hour\\b|\\ban\\s+hour\\b|\\b{NUMBER_WORDS}[\\s-]+(min|mins|minute|minutes|hour|hours|hrs?)\\b\",\n68\t    re.IGNORECASE)\n69\t# Rule 3: never imply CMMC, FedRAMP or CUI capability, and no ITAR claim.\n70\tDEFENSE = re.compile(r\"(\\bc\\.?\\s?m\\.?\\s?m\\.?\\s?c\\b|cybersecurity\\s+maturity\\s+model|\\bfed\\s*-?\\s*ramp\\b|\"\n71\t                     r\"federal\\s+risk\\s+and\\s+authori[sz]ation|\\bcui\\b|controlled[\\s-]+unclassified|\\bitar\\b|\"\n72\t                     r\"international\\s+traffic\\s+in\\s+arms|\\bnist\\s*(sp\\s*)?800[\\s-]*171\\b|\\bdfars\\b)\", re.IGNORECASE)\n73\tSLOP = re.compile(r\"(in today's|rapidly evolving|game[- ]changer|\\bunlock\\w*|\\bleverag\\w*|seamless\\w*|\"\n74\t                  r\"cutting[- ]edge|revolutioni\\w+|synerg\\w+|\\bdelve\\w*|hope this finds you|\\bai\\s+governance\\b|\\u2014)\", re.IGNORECASE)\n75\t# Links and markup that are not approved sources.\n76\tMARKUP = re.compile(r\"(<\\s*[a-z!/]|!\\[|\\]\\()\", re.IGNORECASE)\n77\tBARE_LINK = re.compile(r\"(//[a-z0-9-]+\\.[a-z0-9.-]+|\\bwww\\.[a-z0-9-]+|\"\n78\t                       r\"\\b(?:[a-z0-9-]+\\.)+(?:com|net|org|io|ai|gov|ca|co|dev|app|info|biz|us|uk|eu|xyz|site|example)\\b)\",\n79\t                       re.IGNORECASE)\n80\t\n81\t\n82\tdef _is_claim_line(text: str, claim_texts: dict[str, str]) -> bool:\n83\t    plain = _norm(text)\n84\t    return bool(plain) and any(plain in _norm(t) for t in claim_texts.values())\n85\t\n86\t\n87\tdef _norm(text: str) -> str:\n88\t    return re.sub(r\"\\s+\", \" \", CITATION.sub(\"\", text)).strip().rstrip(\".\").strip().lower()\n89\t\n90\t\n91\tdef _sentences(lines: list[str]) -> list[str]:\n92\t    out = []\n93\t    for line in lines:\n94\t        line = line.strip()\n95\t        if not line or line in KNOWN_HEADINGS:\n96\t            continue\n97\t        line = line.lstrip(\"#\").strip().lstrip(\"-*\").strip()\n98\t        out += [s for s in re.split(r\"(?<=[.!?])\\s+(?!\\[)\", line) if s.strip()]\n99\t    return out\n100\t\n101\t\n102\tRECIPIENTS_SECTION = \"## Suggested recipients in the existing relationship\"\n103\t# Conservative word families (adversarial QA F4): blocked anywhere outside the quoted approved claims and the\n104\t# rendered recipient lines, however they are phrased.\n105\tFAMILIES = re.compile(\n106\t    r\"\\bcompli\\w*|\\bcertif\\w*|\\baccredit\\w*|\\battest\\w*|\\bassured\\b|\\bvalidat\\w*|\\bconformit\\w*|\"\n107\t    r\"\\b(independent\\w*|third[\\s-]*party|external\\w*|outside)\\b[^.]{0,40}\\b(assur\\w*|review\\w*|audit\\w*|vouch\\w*)|\"\n108\t    r\"\\biso\\s*-?\\s*\\d{4,5}|\\bsoc\\s*-?\\s*(2|ii)\\b|\\baudit\\s+opinion\", re.IGNORECASE)\n109\tDURATION_WORDS = re.compile(r\"\\b(minutes?|mins?|hours?|hrs?)\\b\", re.IGNORECASE)\n110\t# A conditional line may not widen a rule's scope (independent fact-check F-02, F-07).\n111\tOVERSTATE = re.compile(\n112\t    r\"\\bappl(y|ies) to (that|this|the|its|each|any|every|all) ([\\w-]+ ){0,2}(entity|entities|organi[sz]ations?|arm|\"\n113\t    r\"subsidiar\\w*|bank|banks)\\b|\\bany (us )?(banking )?(entity|organi[sz]ation) (supervised|regulated)\\b|\"\n114\t    r\"\\b(dora|sr 26-2) applies\\b\", re.IGNORECASE)\n115\t\n116\t\n117\tdef check_brief(text: str, *, allowed_ids: set[str], allowed_urls: set[str], claim_texts: dict[str, str],\n118\t                caveat_required: bool, recipient_lines: list[str] | None = None,\n119\t                excluded_names: list[str] | tuple = ()) -> list[str]:\n120\t    problems: list[str] = []\n121\t    body, sep, sources = text.partition(\"\\n## Sources\")\n122\t\n123\t    for section in REQUIRED_SECTIONS:\n124\t        if section not in text:\n125\t            problems.append(f\"missing section '{section}'\")\n126\t    # The word limit covers the forwardable part; recipients and open questions are notes for the owner.\n127\t    forwardable = body.split(\"\\n## Suggested recipients in the existing relationship\")[0]\n128\t    words = len(re.findall(r\"\\b\\w+\\b\", CITATION.sub(\"\", forwardable)))\n129\t    if words > MAX_WORDS:\n130\t        problems.append(f\"forwardable brief is {words} words; limit is {MAX_WORDS}\")\n131\t\n132\t    # Sources: only generated source lines, each for an id the body cites.\n133\t    listed = set()\n134\t    for line in sources.splitlines():\n135\t        if not line.strip():\n136\t            continue\n137\t        m = SOURCE_LINE.match(line.strip())\n138\t        if not m:\n139\t            problems.append(f\"unexpected text in Sources: {line.strip()[:80]!r}\")\n140\t        else:\n141\t            listed.add(m.group(1))\n142\t\n143\t    cited = set(CITATION.findall(text))\n144\t    if not cited:\n145\t        problems.append(\"brief cites no sources\")\n146\t    for cid in sorted(cited - allowed_ids):\n147\t        problems.append(f\"cites unknown source id [{cid}]\")\n148\t    for cid in sorted(set(CITATION.findall(body)) - listed):\n149\t        problems.append(f\"[{cid}] is cited but not listed under Sources\")\n150\t    for url in sorted({u.rstrip(\".\") for u in URL.findall(text)} - allowed_urls):\n151\t        problems.append(f\"contains a URL that is not an approved source: {url}\")\n152\t    stripped = URL.sub(\" \", text)\n153\t    for hit in sorted({m.group(0) for m in BARE_LINK.finditer(stripped)}):\n154\t        problems.append(f\"contains a link or domain that is not an approved source: {hit}\")\n155\t    if MARKUP.search(text):\n156\t        problems.append(\"contains HTML or markdown links or images\")\n157\t\n158\t    section = \"\"\n159\t    for raw in body.splitlines():\n160\t        line = raw.strip()\n161\t        if not line:\n162\t            continue\n163\t        if line.startswith(\"## \"):\n164\t            section = line\n165\t            if line not in KNOWN_HEADINGS:\n166\t                problems.append(f\"unexpected section {line[:60]!r}\")\n167\t            continue\n168\t        if line.startswith(\"# \") and not section:\n169\t            continue  # the title\n170\t        content = re.sub(r\"^([-*+]|\\d+[.)])\\s+\", \"\", line)\n171\t        if not section:\n172\t            if not content.startswith(\"Prepared for \"):\n173\t                problems.append(f\"unexpected text before the first section: {line[:80]!r}\")\n174\t            continue\n175\t        if section == RECIPIENTS_SECTION and recipient_lines is not None:\n176\t            if line not in recipient_lines:\n177\t                problems.append(f\"names a recipient that routing did not return: {line[:80]!r}\")\n178\t            continue  # rendered from the audited routed set; titles may contain words like \"compliance\"\n179\t        if not _is_claim_line(content, claim_texts):\n180\t            fam = FAMILIES.search(CITATION.sub(\"\", content))\n181\t            if fam:\n182\t                problems.append(f\"claims or implies compliance, certification, assurance or validation ({fam.group(0)!r}): {line[:80]!r}\")\n183\t            if DURATION_WORDS.search(content):\n184\t                problems.append(f\"states a duration: {line[:80]!r}\")\n185\t        if OVERSTATE.search(CITATION.sub(\"\", content)):\n186\t            problems.append(f\"overstates a rule's scope: {line[:80]!r}\")\n187\t        if section == CONDITIONAL_SECTION:\n188\t            if not content.lower().startswith(\"confirm\"):\n189\t                problems.append(f\"every line in '{CONDITIONAL_SECTION}' must start with 'Confirm': {line[:80]!r}\")\n190\t        elif APPLIES.search(CITATION.sub(\"\", content)) and not _is_claim_line(content, claim_texts):\n191\t            problems.append(f\"says a rule applies outside the conditional section: {line[:80]!r}\")\n192\t        if section in CITED_SECTIONS and not CITATION.search(line):\n193\t            problems.append(f\"line has no citation: {line[:80]!r}\")\n194\t\n195\t    approved = {cid: _norm(t) for cid, t in claim_texts.items()}\n196\t    for sentence in _sentences(body.splitlines()):\n197\t        plain = _norm(sentence)\n198\t        ids = set(CITATION.findall(sentence))\n199\t        is_claim_text = any(plain and plain in approved[i] for i in ids if i in approved)\n200\t        if PRODUCT.search(CITATION.sub(\"\", sentence)) and not is_claim_text and plain + \".\" not in ACCOUNT_FACT_SENTENCES:\n201\t            problems.append(f\"product sentence does not restate its cited approved claim: {sentence[:80]!r}\")\n202\t        if CLAIMS.search(sentence) and not is_claim_text:\n203\t            problems.append(f\"claims or implies compliance, certification, assurance or validation: {sentence[:80]!r}\")\n204\t    if DURATION.search(body):\n205\t        problems.append(\"states a duration\")\n206\t    for name in excluded_names:\n207\t        if name and name in text:\n208\t            problems.append(f\"names a contact that routing excluded: {name!r}\")\n209\t    if DEFENSE.search(text):\n210\t        problems.append(\"mentions CMMC, FedRAMP, CUI or ITAR\")\n211\t    slop = SLOP.findall(text)\n212\t    if slop:\n213\t        problems.append(f\"filler or banned phrasing: {sorted({s if isinstance(s, str) else s[0] for s in slop})}\")\n214\t\n215\t    if caveat_required and \"applicability requires confirmation\" not in body.lower():\n216\t        problems.append(\"preflight requires the phrase 'applicability requires confirmation'\")\n217\t    return problems\n218\t"}]},"parent_tool_use_id":null,"session_id":"d5fdad30-284c-4421-8ab8-20f5f20c459b","uuid":"1d951003-31bd-416b-bf90-1cce5b30fd57","timestamp":"2026-09-24T15:54:15.497Z","tool_use_result":{"type":"text","file":{"filePath":"$REPO/agent/processing/checks.py","content":"\"\"\"Output gate for briefs: deterministic checks that run on every draft, template or model.\n\nA brief that fails any check is not written, and the failure goes to the error\nlog. The content rules come from iTmethods' own public pages\n(docs/research/itmethods-product-facts.md; operator decision A-029).\n\nHardened after independent QA (Q-005) and security review (D-020):\n- every line is checked, including headings and the Sources section, and the\n  Sources section may only contain source lines in the generated format;\n- a sentence that mentions Reign, Forge or iTmethods (any case) must restate\n  the claim it cites word for word, so the right claim id is needed, not just any;\n- there is no negation escape: only the approved claim text itself may use\n  words like \"certification\" (it says iTmethods does not issue one);\n- links of any shape that are not approved sources are rejected, as are HTML\n  and markdown images, which could leak data when a brief is rendered.\n\nWhat no word list can catch is a claim that is plausible and false. The named\nhuman approver is the control for that.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\nMAX_WORDS = 350  # proposed A-045: a short brief a CAE can read in one sitting\n# The structure the operator decided for the SR 26-2 brief (A-044).\nREQUIRED_SECTIONS = [\"## What changed\", \"## What is certain for this account\", \"## What depends on structure (confirm)\",\n                     \"## What we know about the account\", \"## Where Reign fits\", \"## Suggested next step\",\n                     \"## Suggested recipients in the existing relationship\", \"## Open questions for the account owner\",\n                     \"## Sources\"]\n# Optional owner-only section after the recipients: the agent's risk-lane and engineering-lane framings.\nOPTIONAL_SECTIONS = [\"## Lane framings for the account owner\"]\nKNOWN_HEADINGS = set(REQUIRED_SECTIONS) | set(OPTIONAL_SECTIONS)\nCONDITIONAL_SECTION = \"## What depends on structure (confirm)\"\n# \"Never claim a rule applies\" (A-044): applicability wording only inside the conditional section.\nAPPLIES = re.compile(r\"\\b(applies|apply to (you|the bank|them)|applicable to|in scope|subject to|covered by|falls (under|within)|\"\n                     r\"governs?|governed by|binds?|binding on|must (comply|follow|meet|adopt)|required to (comply|follow)|\"\n                     r\"obliged|obligated|regulated under|compl(y|ies) with)\\b\", re.IGNORECASE)\n# Sections where every line must carry a citation (QA pass 2, C1).\nCITED_SECTIONS = {\"## What changed\", \"## What is certain for this account\", CONDITIONAL_SECTION,\n                  \"## What we know about the account\", \"## Where Reign fits\"}\n# Template sentences about the account that name a product but make no product claim.\nACCOUNT_FACT_SENTENCES = {\"existing forge customer.\"}\n\nCITATION = re.compile(r\"\\[([A-Za-z0-9][A-Za-z0-9:_/.\\-]*)\\]\")\nURL = re.compile(r\"https?://[^\\s,;)\\]]+[^\\s,;.)\\]]\", re.IGNORECASE)\nPRODUCT = re.compile(r\"\\b(reign|forge|itmethods)\\b\", re.IGNORECASE)\nSOURCE_LINE = re.compile(r\"^- \\[([A-Za-z0-9][A-Za-z0-9:_/.\\-]*)\\] (.+)$\")\n\n# Rule 1: never claim or imply compliance, certification, independent assurance or validation.\nCLAIMS = re.compile(\n    r\"\\b(compliant|complian\\w*\\s+(for|with)\\s+you|certif\\w*|accredit\\w*|attest\\w*|audit\\s+opinion|soc\\s*-?\\s*2|\"\n    r\"iso\\s*-?\\s*\\d{4,5}\\s+(certified|compliant)|\"\n    r\"(independent|third[\\s-]*party)\\s*(ly\\s+)?(assurance|validation|validat\\w*|review\\w*|audit\\w*)|\"\n    r\"validated\\s+by|validat\\w*\\s+(your|their|the\\s+bank)|\"\n    r\"(ensure|ensures|guarantee\\w*|achieve\\w*|deliver\\w*|handles?|provides?)\\s+([\\w-]+\\s+){0,3}compliance|\"\n    r\"in\\s+line\\s+with\\s+(sr|osfi|dora|the\\s+guidance|every|all)|\"\n    r\"(satisf\\w*|meets?|fulfil\\w*)\\s+([\\w-]+\\s+){0,3}(expectation|requirement|obligation|guidance|rule)s?|\"\n    r\"sign[\\s-]*off|pass\\w*\\s+([\\w-]+\\s+){0,4}(exam|examination|audit|inspection)s?|soc[\\s-]*(2|ii)\\b|vouch\\w*|\"\n    r\"(examiner|regulator|auditor)s?\\s+([\\w-]+\\s+){0,3}(approv|accept|sign)\\w*)\\b\",\n    re.IGNORECASE)\n# Rule 2: never state a briefing or meeting duration, in digits or words.\nNUMBER_WORDS = (r\"(one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|fifteen|twenty|thirty|forty|\"\n                r\"forty[\\s-]*five|fifty|sixty|ninety|a\\s+couple\\s+of|a\\s+few|several)\")\nDURATION = re.compile(\n    r\"\\b\\d+\\s*(?:-|to|\\u2013)?\\s*\\d*\\s*(?:m|min|mins|minute|minutes|h|hr|hrs|hour|hours)\\b|\"\n    rf\"\\b(half|quarter)[\\s-]+(an|of\\s+an)[\\s-]+hour\\b|\\ban\\s+hour\\b|\\b{NUMBER_WORDS}[\\s-]+(min|mins|minute|minutes|hour|hours|hrs?)\\b\",\n    re.IGNORECASE)\n# Rule 3: never imply CMMC, FedRAMP or CUI capability, and no ITAR claim.\nDEFENSE = re.compile(r\"(\\bc\\.?\\s?m\\.?\\s?m\\.?\\s?c\\b|cybersecurity\\s+maturity\\s+model|\\bfed\\s*-?\\s*ramp\\b|\"\n                     r\"federal\\s+risk\\s+and\\s+authori[sz]ation|\\bcui\\b|controlled[\\s-]+unclassified|\\bitar\\b|\"\n                     r\"international\\s+traffic\\s+in\\s+arms|\\bnist\\s*(sp\\s*)?800[\\s-]*171\\b|\\bdfars\\b)\", re.IGNORECASE)\nSLOP = re.compile(r\"(in today's|rapidly evolving|game[- ]changer|\\bunlock\\w*|\\bleverag\\w*|seamless\\w*|\"\n                  r\"cutting[- ]edge|revolutioni\\w+|synerg\\w+|\\bdelve\\w*|hope this finds you|\\bai\\s+governance\\b|\\u2014)\", re.IGNORECASE)\n# Links and markup that are not approved sources.\nMARKUP = re.compile(r\"(<\\s*[a-z!/]|!\\[|\\]\\()\", re.IGNORECASE)\nBARE_LINK = re.compile(r\"(//[a-z0-9-]+\\.[a-z0-9.-]+|\\bwww\\.[a-z0-9-]+|\"\n                       r\"\\b(?:[a-z0-9-]+\\.)+(?:com|net|org|io|ai|gov|ca|co|dev|app|info|biz|us|uk|eu|xyz|site|example)\\b)\",\n                       re.IGNORECASE)\n\n\ndef _is_claim_line(text: str, claim_texts: dict[str, str]) -> bool:\n    plain = _norm(text)\n    return bool(plain) and any(plain in _norm(t) for t in claim_texts.values())\n\n\ndef _norm(text: str) -> str:\n    return re.sub(r\"\\s+\", \" \", CITATION.sub(\"\", text)).strip().rstrip(\".\").strip().lower()\n\n\ndef _sentences(lines: list[str]) -> list[str]:\n    out = []\n    for line in lines:\n        line = line.strip()\n        if not line or line in KNOWN_HEADINGS:\n            continue\n        line = line.lstrip(\"#\").strip().lstrip(\"-*\").strip()\n        out += [s for s in re.split(r\"(?<=[.!?])\\s+(?!\\[)\", line) if s.strip()]\n    return out\n\n\nRECIPIENTS_SECTION = \"## Suggested recipients in the existing relationship\"\n# Conservative word families (adversarial QA F4): blocked anywhere outside the quoted approved claims and the\n# rendered recipient lines, however they are phrased.\nFAMILIES = re.compile(\n    r\"\\bcompli\\w*|\\bcertif\\w*|\\baccredit\\w*|\\battest\\w*|\\bassured\\b|\\bvalidat\\w*|\\bconformit\\w*|\"\n    r\"\\b(independent\\w*|third[\\s-]*party|external\\w*|outside)\\b[^.]{0,40}\\b(assur\\w*|review\\w*|audit\\w*|vouch\\w*)|\"\n    r\"\\biso\\s*-?\\s*\\d{4,5}|\\bsoc\\s*-?\\s*(2|ii)\\b|\\baudit\\s+opinion\", re.IGNORECASE)\nDURATION_WORDS = re.compile(r\"\\b(minutes?|mins?|hours?|hrs?)\\b\", re.IGNORECASE)\n# A conditional line may not widen a rule's scope (independent fact-check F-02, F-07).\nOVERSTATE = re.compile(\n    r\"\\bappl(y|ies) to (that|this|the|its|each|any|every|all) ([\\w-]+ ){0,2}(entity|entities|organi[sz]ations?|arm|\"\n    r\"subsidiar\\w*|bank|banks)\\b|\\bany (us )?(banking )?(entity|organi[sz]ation) (supervised|regulated)\\b|\"\n    r\"\\b(dora|sr 26-2) applies\\b\", re.IGNORECASE)\n\n\ndef check_brief(text: str, *, allowed_ids: set[str], allowed_urls: set[str], claim_texts: dict[str, str],\n                caveat_required: bool, recipient_lines: list[str] | None = None,\n                excluded_names: list[str] | tuple = ()) -> list[str]:\n    problems: list[str] = []\n    body, sep, sources = text.partition(\"\\n## Sources\")\n\n    for section in REQUIRED_SECTIONS:\n        if section not in text:\n            problems.append(f\"missing section '{section}'\")\n    # The word limit covers the forwardable part; recipients and open questions are notes for the owner.\n    forwardable = body.split(\"\\n## Suggested recipients in the existing relationship\")[0]\n    words = len(re.findall(r\"\\b\\w+\\b\", CITATION.sub(\"\", forwardable)))\n    if words > MAX_WORDS:\n        problems.append(f\"forwardable brief is {words} words; limit is {MAX_WORDS}\")\n\n    # Sources: only generated source lines, each for an id the body cites.\n    listed = set()\n    for line in sources.splitlines():\n        if not line.strip():\n            continue\n        m = SOURCE_LINE.match(line.strip())\n        if not m:\n            problems.append(f\"unexpected text in Sources: {line.strip()[:80]!r}\")\n        else:\n            listed.add(m.group(1))\n\n    cited = set(CITATION.findall(text))\n    if not cited:\n        problems.append(\"brief cites no sources\")\n    for cid in sorted(cited - allowed_ids):\n        problems.append(f\"cites unknown source id [{cid}]\")\n    for cid in sorted(set(CITATION.findall(body)) - listed):\n        problems.append(f\"[{cid}] is cited but not listed under Sources\")\n    for url in sorted({u.rstrip(\".\") for u in URL.findall(text)} - allowed_urls):\n        problems.append(f\"contains a URL that is not an approved source: {url}\")\n    stripped = URL.sub(\" \", text)\n    for hit in sorted({m.group(0) for m in BARE_LINK.finditer(stripped)}):\n        problems.append(f\"contains a link or domain that is not an approved source: {hit}\")\n    if MARKUP.search(text):\n        problems.append(\"contains HTML or markdown links or images\")\n\n    section = \"\"\n    for raw in body.splitlines():\n        line = raw.strip()\n        if not line:\n            continue\n        if line.startswith(\"## \"):\n            section = line\n            if line not in KNOWN_HEADINGS:\n                problems.append(f\"unexpected section {line[:60]!r}\")\n            continue\n        if line.startswith(\"# \") and not section:\n            continue  # the title\n        content = re.sub(r\"^([-*+]|\\d+[.)])\\s+\", \"\", line)\n        if not section:\n            if not content.startswith(\"Prepared for \"):\n                problems.append(f\"unexpected text before the first section: {line[:80]!r}\")\n            continue\n        if section == RECIPIENTS_SECTION and recipient_lines is not None:\n            if line not in recipient_lines:\n                problems.append(f\"names a recipient that routing did not return: {line[:80]!r}\")\n            continue  # rendered from the audited routed set; titles may contain words like \"compliance\"\n        if not _is_claim_line(content, claim_texts):\n            fam = FAMILIES.search(CITATION.sub(\"\", content))\n            if fam:\n                problems.append(f\"claims or implies compliance, certification, assurance or validation ({fam.group(0)!r}): {line[:80]!r}\")\n            if DURATION_WORDS.search(content):\n                problems.append(f\"states a duration: {line[:80]!r}\")\n        if OVERSTATE.search(CITATION.sub(\"\", content)):\n            problems.append(f\"overstates a rule's scope: {line[:80]!r}\")\n        if section == CONDITIONAL_SECTION:\n            if not content.lower().startswith(\"confirm\"):\n                problems.append(f\"every line in '{CONDITIONAL_SECTION}' must start with 'Confirm': {line[:80]!r}\")\n        elif APPLIES.search(CITATION.sub(\"\", content)) and not _is_claim_line(content, claim_texts):\n            problems.append(f\"says a rule applies outside the conditional section: {line[:80]!r}\")\n        if section in CITED_SECTIONS and not CITATION.search(line):\n            problems.append(f\"line has no citation: {line[:80]!r}\")\n\n    approved = {cid: _norm(t) for cid, t in claim_texts.items()}\n    for sentence in _sentences(body.splitlines()):\n        plain = _norm(sentence)\n        ids = set(CITATION.findall(sentence))\n        is_claim_text = any(plain and plain in approved[i] for i in ids if i in approved)\n        if PRODUCT.search(CITATION.sub(\"\", sentence)) and not is_claim_text and plain + \".\" not in ACCOUNT_FACT_SENTENCES:\n            problems.append(f\"product sentence does not restate its cited approved claim: {sentence[:80]!r}\")\n        if CLAIMS.search(sentence) and not is_claim_text:\n            problems.append(f\"claims or implies compliance, certification, assurance or validation: {sentence[:80]!r}\")\n    if DURATION.search(body):\n        problems.append(\"states a duration\")\n    for name in excluded_names:\n        if name and name in text:\n            problems.append(f\"names a contact that routing excluded: {name!r}\")\n    if DEFENSE.search(text):\n        problems.append(\"mentions CMMC, FedRAMP, CUI or ITAR\")\n    slop = SLOP.findall(text)\n    if slop:\n        problems.append(f\"filler or banned phrasing: {sorted({s if isinstance(s, str) else s[0] for s in slop})}\")\n\n    if caveat_required and \"applicability requires confirmation\" not in body.lower():\n        problems.append(\"preflight requires the phrase 'applicability requires confirmation'\")\n    return problems\n","numLines":218,"startLine":1,"totalLines":218}}}
