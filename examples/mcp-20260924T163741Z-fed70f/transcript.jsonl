   \"when\": \"outside_jurisdiction\",\n      \"text\": \"Confirm: whether {account} has a US banking organization regulated by the Federal Reserve; the letter addresses those organizations and is expected to be most relevant above $30 billion in total assets, so applicability requires confirmation.\",\n      \"source\": \"src-sr26-2\"\n    },\n    {\n      \"when\": \"in_jurisdiction\",\n      \"text\": \"Confirm: whether {account}'s banking organizations are regulated by the Federal Reserve, and their total assets; the letter is expected to be most relevant above $30 billion.\",\n      \"source\": \"src-sr26-2\"\n    },\n    {\n      \"when\": \"always\",\n      \"text\": \"Confirm: whether {account} has EU entities of the types DORA (Regulation (EU) 2022/2554) covers; per EIOPA, 20 types of financial entities plus ICT third-party providers, so it depends on entity type, jurisdiction and facts.\",\n      \"source\": \"src-dora\"\n    }\n  ],\n  \"note\": \"Read the source URLs yourself. Cite only these source ids; any other URL fails the gate.\"\n}"}]}
